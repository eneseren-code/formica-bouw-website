# Public URL used for canonical, hreflang and social metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Private superadmin credentials. Keep real values only in .env.local.
SUPERADMIN_USERNAME=your-superadmin-username
SUPERADMIN_PASSWORD=replace-with-a-strong-password-of-at-least-8-characters

# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Resend — RESEND_FROM_EMAIL must use a verified domain.
RESEND_API_KEY=re_YOUR_API_KEY
RESEND_FROM_EMAIL=Formica Bouw <website@formicabouw.com>
LEAD_NOTIFICATION_EMAIL=info@formicabouw.com

# Replace with a long random value before handling real submissions.
RATE_LIMIT_SECRET=replace-with-a-long-random-secret
